{
  "schema": "m3-fault-phase-registry-v1",
  "description": "Frozen M3 fault boundaries. state_disposition is the in-process state at the boundary; error_disposition is the API disposition if that boundary returns an injected error; kill_recovery is the only durable generation set accepted after process termination.",
  "phases": [
    {
      "id": "snapshot.cut.before",
      "boundary": "Before begin_consistent_snapshot() closes mutation admission",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "snapshot.cut.during_drain",
      "boundary": "During active mutation drain inside begin_consistent_snapshot()",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "snapshot.cut.after_token_active",
      "boundary": "After snapshot token activation and before mutation admission reopens",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "cow.preimage.alloc.before",
      "boundary": "Before bounded COW pre-image allocation",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "cow.preimage.alloc.after",
      "boundary": "After bounded COW pre-image allocation and before publication",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "cow.preimage.publish.before",
      "boundary": "Immediately before publishing a prepared COW pre-image",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "cow.preimage.publish.after",
      "boundary": "After COW pre-image publication to the snapshot coordinator",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },

    {
      "id": "journal.append.data.before",
      "boundary": "Before exact append of a DATA record",
      "short": true, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.append.data.after",
      "boundary": "After exact DATA record append and before the next record",
      "short": false, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.append.zero.before",
      "boundary": "Before exact append of a ZERO record",
      "short": true, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.append.zero.after",
      "boundary": "After exact ZERO record append and before the next record",
      "short": false, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.append.discard.before",
      "boundary": "Before exact append of a DISCARD record",
      "short": true, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.append.discard.after",
      "boundary": "After exact DISCARD record append and before the next record",
      "short": false, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.append.index_node.before",
      "boundary": "Before exact append of an INDEX_NODE record",
      "short": true, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.append.index_node.after",
      "boundary": "After exact INDEX_NODE append and before the next record",
      "short": false, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.commit.append.before",
      "boundary": "Before exact append of CHECKPOINT_COMMIT",
      "short": true, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.commit.append.after",
      "boundary": "After CHECKPOINT_COMMIT append and before journal flush",
      "short": false, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.flush.before",
      "boundary": "Before FlushFileBuffers() on the journal",
      "short": false, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.flush.error",
      "boundary": "When journal FlushFileBuffers() returns an error",
      "short": false, "torn": false, "kill": false, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "NotApplicable"
    },
    {
      "id": "journal.flush.after",
      "boundary": "After journal flush succeeds and before readback",
      "short": false, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.readback.before",
      "boundary": "Before exact readback of all newly committed journal bytes",
      "short": true, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "journal.readback.corrupt",
      "boundary": "When journal readback CRC or digest validation fails",
      "short": false, "torn": false, "kill": false, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "NotApplicable"
    },
    {
      "id": "journal.readback.after",
      "boundary": "After complete journal readback validation and before manifest publication",
      "short": false, "torn": false, "kill": true, "gate": "m3-v1",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },

    {
      "id": "manifest.slot_write.before",
      "boundary": "Before the uncancellable manifest slot-write attempt begins",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "manifest.slot_write.short",
      "boundary": "When the manifest slot write returns fewer than 4096 bytes",
      "short": true, "torn": false, "kill": false, "gate": "m3-v2",
      "state_disposition": "CommitIndeterminate", "error_disposition": "CommitIndeterminate", "kill_recovery": "NotApplicable"
    },
    {
      "id": "manifest.slot_write.torn",
      "boundary": "During a sector-aligned torn manifest slot write followed by process termination",
      "short": false, "torn": true, "kill": true, "gate": "m3-v2",
      "state_disposition": "CommitIndeterminate", "error_disposition": "NotApplicable", "kill_recovery": "OldOrNewCompleteGeneration"
    },
    {
      "id": "manifest.slot_write.after",
      "boundary": "After exact slot write completes and before manifest flush",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "CommitIndeterminate", "error_disposition": "NotApplicable", "kill_recovery": "OldOrNewCompleteGeneration"
    },
    {
      "id": "manifest.flush.before",
      "boundary": "Before FlushFileBuffers() on the manifest after slot-write attempt",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "CommitIndeterminate", "error_disposition": "CommitIndeterminate", "kill_recovery": "OldOrNewCompleteGeneration"
    },
    {
      "id": "manifest.flush.error",
      "boundary": "When manifest FlushFileBuffers() returns an error",
      "short": false, "torn": false, "kill": false, "gate": "m3-v2",
      "state_disposition": "CommitIndeterminate", "error_disposition": "CommitIndeterminate", "kill_recovery": "NotApplicable"
    },
    {
      "id": "manifest.flush.after",
      "boundary": "After manifest flush succeeds at the unique commit point",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "Committed", "error_disposition": "NotApplicable", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "manifest.readback.before",
      "boundary": "Before re-reading the durably published manifest slot",
      "short": true, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "Committed", "error_disposition": "CommittedNeedsReconciliation", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "manifest.readback.corrupt",
      "boundary": "When published manifest readback CRC or field validation fails",
      "short": false, "torn": false, "kill": false, "gate": "m3-v2",
      "state_disposition": "CommittedNeedsReconciliation", "error_disposition": "CommittedNeedsReconciliation", "kill_recovery": "NotApplicable"
    },
    {
      "id": "manifest.readback.after",
      "boundary": "After full published-candidate validation succeeds",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "Committed", "error_disposition": "NotApplicable", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "backing.view_install.before",
      "boundary": "Before install_backing_view() for the committed generation",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "Committed", "error_disposition": "CommittedNeedsReconciliation", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "backing.view_install.after",
      "boundary": "After backing view installation and before conditional acknowledgment",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "Committed", "error_disposition": "NotApplicable", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "backing.ack.each.before",
      "boundary": "Before each mark_persisted() conditional acknowledgment",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "Committed", "error_disposition": "CommittedNeedsReconciliation", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "backing.ack.each.after",
      "boundary": "After each mark_persisted() conditional acknowledgment",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "Committed", "error_disposition": "NotApplicable", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "reconciliation.before",
      "boundary": "Before resolving committed view installation or acknowledgment state",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "CommittedNeedsReconciliation", "error_disposition": "CommittedNeedsReconciliation", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "reconciliation.after",
      "boundary": "After reconciliation completes and the session may return Ready",
      "short": false, "torn": false, "kill": true, "gate": "m3-v2",
      "state_disposition": "Committed", "error_disposition": "NotApplicable", "kill_recovery": "NewCompleteGenerationOnly"
    },

    {
      "id": "compaction.vhdx.create.before",
      "boundary": "Before creating the unique temporary compaction VHDX",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.create.after",
      "boundary": "After unique temporary VHDX creation and before extent writes",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.write.before",
      "boundary": "Before each exact extent write to the temporary VHDX",
      "short": true, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.write.after",
      "boundary": "After each exact temporary VHDX extent write",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.flush.before",
      "boundary": "Before flushing the completed temporary VHDX",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.flush.after",
      "boundary": "After temporary VHDX flush succeeds and before readback",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.readback.before",
      "boundary": "Before complete readback of temporary VHDX format metadata and every written extent",
      "short": true, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.readback.after",
      "boundary": "After complete format-metadata and written-extent readback succeeds",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.validate.before",
      "boundary": "Before validating the temporary VHDX through the product reader",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.validate.after",
      "boundary": "After strict product-reader validation of the temporary VHDX",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.windows_validate.before",
      "boundary": "Before offline Windows Virtual Disk API validation without attaching the temporary VHDX",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.windows_validate.after",
      "boundary": "After offline Windows Virtual Disk API validation succeeds without a second disk attachment",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.rename.before",
      "boundary": "Immediately before handle-relative write-through publication rename",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.vhdx.rename.after",
      "boundary": "After write-through publication of the unique final VHDX name",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.journal.create.before",
      "boundary": "Before creating the new journal epoch",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.journal.create.after",
      "boundary": "After creating the new journal epoch and before genesis flush",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.journal.flush.before",
      "boundary": "Before flushing the new journal epoch genesis",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotCommitted", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "compaction.journal.flush.after",
      "boundary": "After new journal epoch genesis flush and before the consistent cut",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "NotCommitted", "error_disposition": "NotApplicable", "kill_recovery": "OldCompleteGenerationOnly"
    },
    {
      "id": "cleanup.old_file.delete.before",
      "boundary": "Before identity-checked deletion of an eligible obsolete bundle file",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "Committed", "error_disposition": "CommittedNeedsReconciliation", "kill_recovery": "NewCompleteGenerationOnly"
    },
    {
      "id": "cleanup.old_file.delete.after",
      "boundary": "After identity-checked deletion of an eligible obsolete bundle file",
      "short": false, "torn": false, "kill": true, "gate": "m3-v4",
      "state_disposition": "Committed", "error_disposition": "NotApplicable", "kill_recovery": "NewCompleteGenerationOnly"
    }
  ]
}
